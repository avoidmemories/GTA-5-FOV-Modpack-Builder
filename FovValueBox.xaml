<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FovApp">

    <Style TargetType="{x:Type local:FovValueBox}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FovValueBox}">
                    <Border Background="#000000" CornerRadius="6"
                            BorderBrush="#333333" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="PART_Text" Text="0"
                                       Foreground="White" FontSize="12" FontWeight="Medium"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox x:Name="PART_Editor" Text=""
                                     Foreground="White" CaretBrush="White" SelectionBrush="#8A8A8A"
                                     Background="Transparent" BorderThickness="0"
                                     FontSize="12" FontWeight="Medium"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Padding="4,0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
