<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FovApp">

    <!-- The slider renders itself in code (FovSlider.cs): hairline trough,
         filled part and a round white knob. The template only hosts the visual
         tree so the control can find its parts. -->
    <Style TargetType="{x:Type local:FovSlider}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FovSlider}">
                    <Grid x:Name="PART_Root" Background="Transparent">
                        <!-- trough -->
                        <Border x:Name="PART_Trough" Height="4" CornerRadius="2"
                                VerticalAlignment="Center" Background="#262626" />
                        <!-- filled part, up to the knob; BitmapCache makes both
                             moving parts GPU-composited -->
                        <Border x:Name="PART_Fill" Height="4" Width="0" CornerRadius="2"
                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                Background="{TemplateBinding AccentBrush}">
                            <Border.CacheMode>
                                <BitmapCache />
                            </Border.CacheMode>
                        </Border>
                        <!-- knob: circle (no bitmap effects: they force software
                             rendering and are what made dragging stutter) -->
                        <Ellipse x:Name="PART_Knob" Width="14" Height="14" Fill="{TemplateBinding AccentBrush}"
                                 Stroke="#000000" StrokeThickness="1"
                                 HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Ellipse.CacheMode>
                                <BitmapCache />
                            </Ellipse.CacheMode>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
