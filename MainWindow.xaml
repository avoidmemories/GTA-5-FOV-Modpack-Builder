<Window x:Class="FovApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FovApp"
        Title="FOV Modpack Builder"
        Icon="Assets/Icons/app.png"
        Width="960" Height="560"
        MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI"
        SourceInitialized="Window_SourceInitialized">

    <!-- The native title bar already rounds the top of the window.  Keep the
         client surface square there, while retaining the rounded bottom edge. -->
    <Border CornerRadius="0,0,8,8"
            Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
            ClipToBounds="True" Margin="0,0,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================ Sidebar: tab navigation ================ -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Mode: SIMPLE collapses to two master sliders,
                         ADVANCED restores every tab and preset -->
                    <Border Grid.Row="0" Margin="10,12,10,6">
                        <Grid>
                            <Border x:Name="ModeTrough" Style="{StaticResource SegmentTrough}"
                                    HorizontalAlignment="Stretch">
                                <Grid>
                                    <Border x:Name="ModeBacking" Background="{StaticResource WhiteBrush}"
                                            CornerRadius="{StaticResource ControlRadius}"
                                            HorizontalAlignment="Left" Width="0" IsHitTestVisible="False" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="ModeSimple" Content="SIMPLE"
                                                     Style="{StaticResource SegmentToggle}"
                                                     GroupName="UIMode" Click="ModeSimple_Click" />
                                        <RadioButton x:Name="ModeAdvanced" Grid.Column="1" Content="ADVANCED"
                                                     Style="{StaticResource SegmentToggle}"
                                                     GroupName="UIMode" Click="ModeAdvanced_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- FOV presets: aligned with the Global Shift panel height
                         on the content side -->
                    <Border x:Name="PresetBlock" Grid.Row="1" Margin="10,0,10,6">
                        <Grid>
                            <Border x:Name="PresetTrough" Style="{StaticResource SegmentTrough}"
                                    HorizontalAlignment="Stretch">
                                <Grid>
                                    <Border x:Name="PresetBacking" Background="{StaticResource WhiteBrush}"
                                            CornerRadius="{StaticResource ControlRadius}"
                                            HorizontalAlignment="Left" Width="0" IsHitTestVisible="False" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="PresetX15" Content="x15"
                                                     Style="{StaticResource SegmentToggle}"
                                                     GroupName="FovPreset" Click="PresetX15_Click" />
                                        <RadioButton x:Name="PresetX30" Grid.Column="1" Content="x30"
                                                     Style="{StaticResource SegmentToggle}"
                                                     GroupName="FovPreset" Click="PresetX30_Click" />
                                        <RadioButton x:Name="PresetX60" Grid.Column="2" Content="x60"
                                                     Style="{StaticResource SegmentToggle}"
                                                     GroupName="FovPreset" Click="PresetX60_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <!-- dimming + CUSTOM label shown when the user edits
                                 after applying a preset -->
                            <Border x:Name="PresetOverlay" Background="#CC0A0A0A"
                                    CornerRadius="{StaticResource PanelRadius}"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock Text="CUSTOM" Foreground="{StaticResource TextBrush}"
                                           FontSize="11.5" FontWeight="SemiBold" FontFamily="Consolas"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Tabs (name lives in the system title bar) -->
                    <ScrollViewer Grid.Row="2" x:Name="NavScroll"
                                  Style="{StaticResource CategoryNavigationViewer}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NavHost" Margin="10,4,0,0" />
                    </ScrollViewer>

                    <!-- Reset everything: first click arms (label turns red
                         "Are you sure?"), second click resets. Same gesture as
                         SnapHook's destructive actions. -->
                    <Button Grid.Row="3" x:Name="BtnSetDefaults"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" Margin="10,8,10,12"
                            Click="BtnSetDefaults_Click">
                        <TextBlock x:Name="DefaultsLabel" Text="Set all tabs default"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="12.5" FontWeight="Medium"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <!-- ================ Content ================ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Tab pages host -->
                <Grid Grid.Row="0" x:Name="PagesHost" Margin="14,12,14,4" />

                <!-- ============ Footer ============ -->
                <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                        CornerRadius="{StaticResource PanelRadius}" BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1" Padding="14,10,14,12" Margin="14,8,14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Absolute shift: at the left edge of the footer (ADVANCED only) -->
                        <StackPanel x:Name="AbsoluteShiftPanel" Grid.Column="0" Orientation="Horizontal"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="Set exact" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <CheckBox x:Name="AbsoluteShiftToggle"
                                      Style="{StaticResource PillToggle}" IsChecked="False"
                                      VerticalAlignment="Center"
                                      Checked="AbsoluteShift_Changed"
                                      Unchecked="AbsoluteShift_Changed"
                                      ToolTip="Global Shift sets values TO the number, not adds" />
                        </StackPanel>

                        <!-- Export flyout: opens from the chevron right of the label -->
                        <Popup x:Name="ExportPopup" PlacementTarget="{Binding ElementName=BtnBuildExtra}"
                               Placement="Top" VerticalOffset="-4"
                               AllowsTransparency="True" StaysOpen="False"
                               Opened="ExportPopup_Opened"
                               Closed="ExportPopup_Closed">
                            <Border Background="#111111" CornerRadius="8"
                                    BorderBrush="#333333" BorderThickness="1" Padding="6"
                                    x:Name="ExportFlyoutBorder" Opacity="0">
                                <StackPanel x:Name="ExportMenu" MinWidth="150">
                                    <Button x:Name="BtnImportYmt" Content="Import file"
                                            Style="{StaticResource FlyoutItem}"
                                            Height="24" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Margin="10,1" Click="BtnImportYmt_Click" />
                                    <Button x:Name="BtnExportPath" Content="Set export folder"
                                            Style="{StaticResource FlyoutItem}"
                                            Height="24" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Margin="10,1" Click="BtnExportPath_Click" />
                                    <Button x:Name="BtnExportYmt" Content="Build only a file"
                                            Style="{StaticResource FlyoutItem}"
                                            Height="24" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Margin="10,1" Click="BtnExportYmt_Click" />
                                    <Button x:Name="BtnBuildZip" Content="Build as .zip"
                                            Style="{StaticResource FlyoutItem}"
                                            Height="24" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Margin="10,1" Click="BtnBuildZip_Click" />
                                    <Button x:Name="BtnBuildOriginal" Content="Build original"
                                            Style="{StaticResource FlyoutItem}"
                                            Height="24" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Margin="10,1" Click="BtnBuildOriginal_Click" />
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Split build button: one white body, a black divider bar
                             that meets the top and bottom edges, chevron on the right
                             opens the export flyout -->
                        <Border Grid.Column="3" Background="White" CornerRadius="6"
                                 Width="164" x:Name="BuildRoot">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnBuild" Grid.Column="0" Content="Build Modpack"
                                        Style="{StaticResource BuildSplitButton}" Click="BtnBuild_Click" />
                                <Border Grid.Column="1" Background="#000000" />
                                <Button x:Name="BtnBuildExtra" Grid.Column="2"
                                        Style="{StaticResource BuildSplitButton}" Padding="0"
                                        Click="BtnBuildExtra_Click">
                                    <Viewbox Width="12" Height="12">
                                        <Canvas Width="16" Height="16">
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2.2" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M6 3.5 L11 8 L6 12.5" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="1" x:Name="StatusText" Text="" Style="{StaticResource BodyText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Margin="0,0,12,0" Cursor="Hand"
                                   MouseLeftButtonUp="StatusText_MouseLeftButtonUp"
                                   MouseEnter="StatusText_MouseEnter"
                                   MouseLeave="StatusText_MouseLeave" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
